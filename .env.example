# Copy to .env and fill in. .env is gitignored and must never be committed.
# docker-compose.yml uses the ${VAR:?} form for the two required values below, so a
# missing DATABASE_URL or POSTGRES_PASSWORD fails the start loudly rather than
# silently bringing Postgres up with unexpected credentials.

# --- Required: database ---
# POSTGRES_PASSWORD is consumed by the postgres service. The same password must also
# appear inside DATABASE_URL, or the app will start but fail to connect.
POSTGRES_PASSWORD="use-a-long-random-password"
# Host must be `postgres` (the compose service name) when running under Docker,
# not localhost. Use localhost:5434 only for host-side tooling over the published port.
DATABASE_URL="postgresql://cloudinvoice:use-a-long-random-password@postgres:5432/cloudinvoice?schema=public"

# --- Required: auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Must match the public origin exactly, including scheme and port. Session cookies
# and trusted origins are derived from this.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google sign-in (optional) ---
# Create an OAuth 2.0 Web application in Google Cloud. Never commit the real secret.
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-with-rotated-google-client-secret"

# --- Payments (optional; card checkout returns 503 until both are set) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Razorpay (optional; for Indian payment methods: UPI, Cards, NetBanking) ---
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# --- Email (optional; sending an invoice fails until set) ---
# The domain in EMAIL_FROM must be verified with your email provider or delivery
# will be rejected. lib/email.ts falls back to Resend's onboarding sender if unset.
RESEND_API_KEY="re_..."
EMAIL_FROM="CloudInvoice <billing@cloudinvoice.co.in>"

# --- Media uploads (optional) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# --- Public contact details (optional) ---
# Shown on /contact and in the footer. Not secrets.
NEXT_PUBLIC_SUPPORT_EMAIL="support@cloudinvoice.co.in"
NEXT_PUBLIC_SECURITY_EMAIL="security@cloudinvoice.co.in"

# --- Distributed rate limiting (optional; local fallback is used when unset) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Keep secrets in .env only; never commit the populated file.


